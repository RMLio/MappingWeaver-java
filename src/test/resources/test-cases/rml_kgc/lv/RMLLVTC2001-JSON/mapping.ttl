@prefix brbdr: <https://www.sciensano.be/en/> .
@prefix dcterms: <https://www.dublincore.org/specifications/dublin-core/dcmi-terms/> .
@prefix ePPO: <https://bioportal.bioontology.org/ontologies/E-PPO/> .
@prefix fhir: <https://www.hl7.org/fhir/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix moveup: <https://moveup.care/> .
@prefix omop: <https://www.ohdsi.org/data-standardization/> .
@prefix openEHR: <https://ckm.openehr.org/ckm/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix phro: <https://ns.faqir.org/phr-o#> .
@prefix prov: <https://www.w3.org/TR/prov-o/> .
@prefix qo: <https://ns.faqir.org/q-o#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <https://www.w3.org/TR/rdf-schema/> .
@prefix s4ehaw: <https://saref.etsi.org/saref4ehaw/> .
@prefix saref: <https://saref.etsi.org/core/> .
@prefix schema: <https://schema.org/> .
@prefix snomed: <http://snomed.info/id/> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .
@prefix sphn: <https://sphn.ch/> .
@prefix tmp: <https://www2.telemonitoring-prescription.com/openapi#> .
@prefix ucum: <https://unitsofmeasure.org/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

@base <http://example.com/>.
@prefix rml: <http://w3id.org/rml/>.

<json> a rml:LogicalSource;
  rml:source [
    a rml:RelativePathSource, rml:Source;
    rml:path "input.json";
    rml:root rml:MappingDirectory;
  ];
  rml:iterator "$.[*]";
  rml:referenceFormulation rml:JSONPath.

<questionnaireResponseView> a rml:LogicalView;
  rml:viewOn <json>;
  rdfs:label "View for moveup's questionnaire responses";
  rml:field [
    rml:fieldName "podId";
    rml:reference "$.podId";
  ];
  rml:field [
    rml:fieldName "patientReference";
    rml:reference "$.subject.reference";
  ];
  rml:field [
    rml:fieldName "status";
    rml:reference "$.status";
  ];
  rml:field [
    rml:fieldName "responseId";
    rml:reference "$.identifier[0].value";
  ];
  rml:field [
    rml:fieldName "questionnaireId";
    rml:reference "$.questionnaire";
  ];
  rml:field [
    rml:fieldName "questionnaireLabel";
    rml:reference "$.text";
  ];
  rml:field [
    rml:fieldName "partOfReference";
    rml:reference "$.partOf[0].reference";
  ];
  rml:field [
    rml:fieldName "creationDate";
    rml:reference "$.authored";
  ];
  rml:field [
    rml:fieldName "sections";
    rml:iterator "$.item[*]"; # TODO SHOULD BE *
    rml:field [
      rml:fieldName "id";
      rml:reference "$.linkId";
    ];
    rml:field [
      rml:fieldName "questions";
      rml:iterator "$.item[*]"; # TODO SHOULD BE *
      rml:field [
        rml:fieldName "id";
        rml:reference "$.linkId";
      ];
      rml:field [
        rml:fieldName "label";
        rml:reference "$.text";
      ];
      rml:field [
        rml:fieldName "type";
        rml:reference "$.type";
      ];
      rml:field [
        rml:fieldName "answers";
        rml:iterator "$.answer[0]"; # TODO SHOULD BE *
        rml:field [
          rml:fieldName "valueCodingCode";
          rml:reference "$.valueCoding.code";
        ];
        rml:field [
          rml:fieldName "valueCodingDisplay";
          rml:reference "$.valueCoding.display";
        ];
        rml:field [
          rml:fieldName "valueDecimal";
          rml:reference "$.valueDecimal";
        ];
        rml:field [
          rml:fieldName "valueDateTime";
          rml:reference "$.valueDateTime";
        ];
        rml:field [
          rml:fieldName "valueString";
          rml:reference "$.valueString";
        ];
      ];
    ];
  ];
  .

##moveup:RCJ67FKWa9WWizrXi
## NOTE: patient MoveUp id is not present in questionnaireResponse.json; using patientReference from subject.reference.
## TODO get patientReference via function
<PatientQuestionnaireResponseLinkTriplesMap> a rml:TriplesMap;
  rml:logicalSource <questionnaireResponseView>;
  rml:subjectMap [
    rml:template "https://moveup.care/{patientReference}";
  ] ;
##    foaf:made <https://moveup.care/QuestionnaireResponse/e9PmCqfRpckhQNTKp> .
  rml:predicateObjectMap [
    rml:predicate foaf:made;
    rml:objectMap [ rml:template "https://moveup.care/QuestionnaireResponse/{responseId}" ];
  ] ;
  .

##<https://moveup.care/QuestionnaireResponse/e9PmCqfRpckhQNTKp>
<ResponseTriplesMap> a rml:TriplesMap;
  rml:logicalSource <questionnaireResponseView>;
  rml:subjectMap [
    rml:template "https://moveup.care/QuestionnaireResponse/{responseId}";
##    a qo:QuestionnaireResponse ;
    rml:class qo:QuestionnaireResponse;
  ] ;
##    qo:questionnaireResponseBySubject <https://moveup.care/identity/moveup-id/RCJ67FKWa9WWizrXi> ;
  rml:predicateObjectMap [
    rml:predicate qo:questionnaireResponseBySubject;
    rml:objectMap [ rml:template "https://moveup.care/{patientReference}" ];
  ];
##    prov:atTime "2026-05-29T13:20:50.544Z"^^xsd:dateTime ;
  rml:predicateObjectMap [
    rml:predicate prov:atTime;
    rml:objectMap [ rml:reference "creationDate"; rml:datatype xsd:dateTime ];
  ];
##    fhir:status fhir:questionnaire-answers-status-completed ;
  rml:predicateObjectMap [
    rml:predicate fhir:status;
    rml:objectMap [ rml:template "https://www.hl7.org/fhir/questionnaire-answers-status-{status}"; rml:termType rml:UnsafeURI ];
  ];
##    qo:questionnaireResponseLastUpdated "2026-05-29T13:20:50.544Z"^^xsd:dateTime ;
  rml:predicateObjectMap [
    rml:predicate qo:questionnaireResponseLastUpdated;
    rml:objectMap [ rml:reference "creationDate"; rml:datatype xsd:dateTime ];
  ];
##    qo:questionnaireResponseToQuestionnaire <https://moveup.care/Questionnaire/vzX565EGcvS9oT2N5> ;
  rml:predicateObjectMap [
    rml:predicate qo:questionnaireResponseToQuestionnaire;
    rml:objectMap [ rml:template "https://moveup.care/{questionnaireId}" ];
  ];
##    dcterms:hasPart <https://moveup.care/Answer/e9PmCqfRpckhQNTKp/MkSBgXBZRFgKnSk5T/OxHo0> ;
  rml:predicateObjectMap [
    rml:predicate dcterms:hasPart;
    rml:objectMap [ rml:parentTriplesMap <AnswerTriplesMap> ];
  ];
##    dcterms:isPartOf <https://moveup.care/Procedure/tDtBhsgnapMSTTHS6> ;
  rml:predicateObjectMap [
    rml:predicate dcterms:isPartOf;
    rml:objectMap [ rml:template "https://moveup.care/{partOfReference}" ];
  ];
##    owl:versionInfo "1.0.0" ;
  rml:predicateObjectMap [
    rml:predicate owl:versionInfo;
    rml:object "1.0.0";
  ];
##    rdfs:label "Example MoveUp Questionnaire Response PACSOI PHR-O v1.0.0"@en ;
  rml:predicateObjectMap [
    rml:predicate rdfs:label;
    rml:object "Example MoveUp Questionnaire Response PACSOI PHR-O v1.0.0"@en;
  ];
##    rdfs:comment "This is an example of a MoveUp Questionnaire Response modelled in the PACSOI PHR-O v1.0.0"@en .
  rml:predicateObjectMap [
    rml:predicate rdfs:comment;
    rml:object "This is an example of a MoveUp Questionnaire Response modelled in the PACSOI PHR-O v1.0.0"@en;
  ] ;
  .

##<https://moveup.care/Answer/e9PmCqfRpckhQNTKp/MkSBgXBZRFgKnSk5T/OxHo0>
<AnswerTriplesMap> a rml:TriplesMap;
  rml:logicalSource <questionnaireResponseView>;
  rml:subjectMap [
    rml:template "https://moveup.care/Answer/{responseId}/{sections.id}/{sections.questions.id}";
##    a qo:Answer ;
    rml:class qo:Answer;
  ] ;
##    qo:answerValue "1" ;
  rml:predicateObjectMap [
    rml:predicate qo:answerValue;
    rml:objectMap [ rml:reference "sections.questions.answers.valueCodingCode" ];
  ];
##    qo:answerValue "1" ;
  rml:predicateObjectMap [
    rml:predicate qo:answerValue;
    rml:objectMap [ rml:reference "sections.questions.answers.valueDecimal"; rml:datatype xsd:float ];
  ];
##    qo:answerValue "1" ;
  rml:predicateObjectMap [
    rml:predicate qo:answerValue;
    rml:objectMap [ rml:reference "sections.questions.answers.valueDateTime"; rml:datatype xsd:dateTime ];
  ];
##    qo:answerValue "1" ;
  rml:predicateObjectMap [
    rml:predicate qo:answerValue;
    rml:objectMap [ rml:reference "sections.questions.answers.valueString" ];
  ];
##    prov:atTime "2026-05-29T13:20:50.544Z"^^xsd:dateTime ;
  rml:predicateObjectMap [
    rml:predicate prov:atTime;
    rml:objectMap [ rml:reference "creationDate"; rml:datatype xsd:dateTime ];
  ];
##    qo:answerIsEmpty false ;
## TODO NOT IN DATA
#   rml:predicateObjectMap [
#     rml:predicate qo:answerIsEmpty;
#     rml:object false;
#   ];
##    qo:answerToQuestion <https://moveup.care/Question/OxHo0> ;
  rml:predicateObjectMap [
    rml:predicate qo:answerToQuestion;
    rml:objectMap [ rml:template "https://moveup.care/Question/{sections.questions.id}" ];
  ];
##    owl:versionInfo "1.0.0" ;
  rml:predicateObjectMap [
    rml:predicate owl:versionInfo;
    rml:object "1.0.0";
  ];
##    rdfs:label "Example MoveUp Answer PACSOI PHR-O v1.0.0"@en ;
  rml:predicateObjectMap [
    rml:predicate rdfs:label;
    rml:object "Example MoveUp Answer PACSOI PHR-O v1.0.0"@en;
  ];
##    rdfs:comment "This is an example of a MoveUp Answer modelled in the PACSOI PHR-O v1.0.0"@en .
  rml:predicateObjectMap [
    rml:predicate rdfs:comment;
    rml:object "This is an example of a MoveUp Answer modelled in the PACSOI PHR-O v1.0.0"@en;
  ] ;
  .

##<https://moveup.care/Question/OxHo0>
<QuestionTriplesMap> a rml:TriplesMap;
  rml:logicalSource <questionnaireResponseView>;
  rml:subjectMap [
    rml:template "https://moveup.care/Question/{sections.questions.id}";
##    a qo:Question ;
    rml:class qo:Question;
  ] ;
##    prov:type fhir:choice ;
  rml:predicateObjectMap [
    rml:predicate prov:type;
    rml:objectMap [ rml:template "https://www.hl7.org/fhir/{sections.questions.type}"; rml:termType rml:UnsafeURI ];
  ];
##    qo:questionRequired false ;
## TODO NOT IN DATA
#   rml:predicateObjectMap [
#     rml:predicate qo:questionRequired;
#     rml:object false;
#   ];
##    qo:questionCodingOrding false ;
## TODO NOT IN DATA
#   rml:predicateObjectMap [
#     rml:predicate qo:questionCodingOrding;
#     rml:object false;
#   ];
##    qo:questionMultivaluedAnswer false ;
## TODO NOT IN DATA
#   rml:predicateObjectMap [
#     rml:predicate qo:questionMultivaluedAnswer;
#     rml:object false;
#   ];
##    qo:questionCodingParams [
  rml:predicateObjectMap [
    rml:predicate qo:questionCodingParams;
    rml:objectMap [ rml:template "https://moveup.care/Question/{sections.questions.id}_codingparams_0" ];
  ];
##    prov:wasAttributedTo <https://moveup.care/> ;
  rml:predicateObjectMap [
    rml:predicate prov:wasAttributedTo;
    rml:object <https://moveup.care/>;
  ];
##    owl:versionInfo "1.0.0" ;
  rml:predicateObjectMap [
    rml:predicate owl:versionInfo;
    rml:object "1.0.0";
  ];
##    rdfs:label "How would you describe the pain you have usually from your knee?"@en ;
  rml:predicateObjectMap [
    rml:predicate rdfs:label;
    rml:objectMap [ rml:reference "sections.questions.label"; rml:language "en" ];
  ];
##    rdfs:comment "This is an example of a MoveUp OxHo0 question modelled in the PACSOI PHR-O v1.0.0"@en .
  rml:predicateObjectMap [
    rml:predicate rdfs:comment;
    rml:objectMap [ rml:template "This is an example of a MoveUp {sections.questions.id} question modelled in the PACSOI PHR-O v1.0.0"; rml:language "en" ];
  ] ;
  .

<QuestionCodingParamsTriplesMap> a rml:TriplesMap;
  rml:logicalSource <questionnaireResponseView>;
  rml:subjectMap [
    rml:template "https://moveup.care/Question/{sections.questions.id}_codingparams_0";
  ] ;
##        fhir:code "1" ;
  rml:predicateObjectMap [
    rml:predicate fhir:code;
    rml:objectMap [ rml:reference "sections.questions.answers.valueCodingCode" ];
  ];
##        fhir:display "Very mild"@en
  rml:predicateObjectMap [
    rml:predicate fhir:display;
    rml:objectMap [ rml:reference "sections.questions.answers.valueCodingDisplay"; rml:language "en" ];
  ] ;
  .

##<https://moveup.care/Questionnaire/vzX565EGcvS9oT2N5>
<QuestionnaireTriplesMap> a rml:TriplesMap;
  rml:logicalSource <questionnaireResponseView>;
  rml:subjectMap [
    rml:template "https://moveup.care/{questionnaireId}";
##    a qo:Questionnaire ;
    rml:class qo:Questionnaire;
  ] ;
##    prov:wasAttributedTo <https://moveup.care/> ;
  rml:predicateObjectMap [
    rml:predicate prov:wasAttributedTo;
    rml:object <https://moveup.care/>;
  ];
##    owl:versionInfo "1.0.0" ;
  rml:predicateObjectMap [
    rml:predicate owl:versionInfo;
    rml:object "1.0.0";
  ];
##    rdfs:label "Oxford Knee Score"@en ;
  rml:predicateObjectMap [
    rml:predicate rdfs:label;
    rml:objectMap [ rml:reference "questionnaireLabel"; rml:language "en" ];
  ];
##    rdfs:comment "This is an example of a MoveUp Oxford Questionnaire modelled in the PACSOI PHR-O v1.0.0"@en .
  rml:predicateObjectMap [
    rml:predicate rdfs:comment;
    rml:object "This is an example of a MoveUp Oxford Questionnaire modelled in the PACSOI PHR-O v1.0.0"@en;
  ] ;
  .
