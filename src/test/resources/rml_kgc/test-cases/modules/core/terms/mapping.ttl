                                ] .

<http://example.com/base/TriplesMap1-RMLTC0029a-JSON>
        rdf:type                rml:TriplesMap;
        rml:logicalSource       [ rdf:type                  rml:LogicalSource;
                                  rml:iterator              "$[*]";
                                  rml:referenceFormulation  rml:JSONPath;
                                  rml:source                [ rdf:type  rml:RelativePathSource;
                                                              rml:path  "RMLTC0029a-JSON/data.json";
                                                              rml:root  rml:MappingDirectory
                                                            ]
                                ];
        rml:predicateObjectMap  [ rml:objectMap  [ rml:reference  "$.FOO" ];
                                  rml:predicate  ex:x
                                ];
        rml:subject             ex:example .
