PREFIX ex:   <http://example.com/>
PREFIX foaf: <http://xmlns.com/foaf/0.1/>
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX rml:  <http://w3id.org/rml/>
PREFIX s:    <http://schema.org/>

<http://example.com/base/TriplesMap1-RMLTC0006a-JSON>
        rdf:type                rml:TriplesMap;
        rml:logicalSource       [ rdf:type                  rml:LogicalSource;
                                  rml:iterator              "$.students[*]";
                                  rml:referenceFormulation  rml:JSONPath;
                                  rml:source                [ rdf:type  rml:RelativePathSource;
                                                              rml:path  "RMLTC0006a-JSON/student.json";
                                                              rml:root  rml:MappingDirectory
                                                            ]
                                ];
        rml:predicateObjectMap  [ rml:objectMap     [ rml:constant  "Bad Student" ];
                                  rml:predicateMap  [ rml:constant  ex:description ]
                                ];
        rml:subjectMap          [ rml:constant  ex:BadStudent;
                                  rml:graphMap  [ rml:constant  <http://example.com/graph/student> ]
                                ] .

<http://example.com/base/TriplesMap1-RMLTC0007b-JSON>
        rdf:type                rml:TriplesMap;
        rml:logicalSource       [ rdf:type                  rml:LogicalSource;
                                  rml:iterator              "$.students[*]";
                                  rml:referenceFormulation  rml:JSONPath;
                                  rml:source                [ rdf:type  rml:RelativePathSource;
                                                              rml:path  "RMLTC0006a-JSON/student.json";
                                                              rml:root  rml:MappingDirectory
                                                            ]
                                ];
        rml:predicateObjectMap  [ rml:objectMap  [ rml:reference  "$.FirstName" ];
                                  rml:predicate  foaf:name
                                ];
        rml:predicateObjectMap  [ rml:object     foaf:Person;
                                  rml:predicate  rdf:type
                                ];
        rml:subjectMap          [ rml:graph     ex:PersonGraph;
                                  rml:template  "http://example.com/Student/{$.ID}/{$.FirstName}"
                                ] .

<http://example.com/base/TriplesMap1-RMLTC0007g-JSON>
        rdf:type                rml:TriplesMap;
        rml:logicalSource       [ rdf:type                  rml:LogicalSource;
                                  rml:iterator              "$.students[*]";
                                  rml:referenceFormulation  rml:JSONPath;
                                  rml:source                [ rdf:type  rml:RelativePathSource;
                                                              rml:path  "RMLTC0006a-JSON/student.json";
                                                              rml:root  rml:MappingDirectory
                                                            ]
                                ];
        rml:predicateObjectMap  [ rml:objectMap  [ rml:reference  "$.FirstName" ];
                                  rml:predicate  foaf:name
                                ];
        rml:subjectMap          [ rml:graph     rml:defaultGraph;
                                  rml:template  "http://example.com/Student/{$.ID}/{$.FirstName}"
                                ] .

<http://example.com/base/TriplesMap1-RMLTC0009b-JSON>
        rdf:type                rml:TriplesMap;
        rml:logicalSource       [ rdf:type                  rml:LogicalSource;
                                  rml:iterator              "$.students[*]";
                                  rml:referenceFormulation  rml:JSONPath;
                                  rml:source                [ rdf:type  rml:RelativePathSource;
                                                              rml:path  "RMLTC0009b-JSON/student.json";
                                                              rml:root  rml:MappingDirectory
                                                            ]
                                ];
        rml:predicateObjectMap  [ rml:graph      <http://example.com/graph/practise>;
                                  rml:objectMap  [ rdf:type              rml:RefObjectMap;
                                                   rml:joinCondition     [ rml:child   "$.Sport";
                                                                           rml:parent  "$.ID"
                                                                         ];
                                                   rml:parentTriplesMap  <http://example.com/base/TriplesMap2-RMLTC0009b-JSON>
                                                 ];
                                  rml:predicate  <http://example.com/ontology/practises>
                                ];
        rml:predicateObjectMap  [ rml:graph      <http://example.com/graph/students>;
                                  rml:objectMap  [ rml:reference  "$.Name" ];
                                  rml:predicate  foaf:name
                                ];
        rml:subjectMap          [ rml:class     <http://example.com/ontology/Student>;
                                  rml:graph     <http://example.com/graph/students>;
                                  rml:template  "http://example.com/resource/student_{$.ID}"
                                ] .

<http://example.com/base/TriplesMap2-RMLTC0009b-JSON>
        rdf:type                rml:TriplesMap;
        rml:logicalSource       [ rdf:type                  rml:LogicalSource;
                                  rml:iterator              "$.sports[*]";
                                  rml:referenceFormulation  rml:JSONPath;
                                  rml:source                [ rdf:type  rml:RelativePathSource;
                                                              rml:path  "RMLTC0009b-JSON/sport.json";
                                                              rml:root  rml:MappingDirectory
                                                            ]
                                ];
        rml:predicateObjectMap  [ rml:objectMap  [ rml:reference  "$.Name" ];
                                  rml:predicate  rdfs:label
                                ];
        rml:subjectMap          [ rml:class     <http://example.com/ontology/Sport>;
                                  rml:graph     <http://example.com/graph/sports>;
                                  rml:template  "http://example.com/resource/sport_{$.ID}"
                                ] .

<http://example.com/base/TriplesMap1-RMLTC0028b-JSON>
        rdf:type                rml:TriplesMap;
        rml:logicalSource       [ rml:iterator              "$[*]";
                                  rml:referenceFormulation  rml:JSONPath;
                                  rml:source                [ rdf:type  rml:RelativePathSource;
                                                              rml:path  "RMLTC0028b-JSON/data.json";
                                                              rml:root  rml:MappingDirectory
                                                            ]
                                ];
        rml:predicateObjectMap  [ rml:graph      rml:defaultGraph;
                                  rml:objectMap  [ rml:reference  "$.name" ];
                                  rml:predicate  s:givenName
                                ];
        rml:subjectMap          [ rml:class     s:Person;
                                  rml:graph     <graph:1>;
                                  rml:template  "https://example.org/instances/{$.id}"
                                ] .
