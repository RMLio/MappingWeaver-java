<http://example.com/base/#Execution-RMLFNMLTC0051-CSV>
        a             rml:FunctionExecution;
        rml:function  grel:toUpperCase;
        rml:input     [ a                  rml:Input;
                        rml:inputValueMap  [ rml:functionExecution  <http://example.com/base/#Execution2-RMLFNMLTC0051-CSV>;
                                             rml:return             grel:stringOut
                                           ];
                        rml:parameter      grel:valueParam
                      ] .

<http://example.com/base/#Execution2-RMLFNMLTC0051-CSV>
        a             rml:Execution;
        rml:function  grel:string_replace;
        rml:input     [ a               rml:Input;
                        rml:inputValue  "-";
                        rml:parameter   grel:param_replace
                      ];
        rml:input     [ a               rml:Input;
                        rml:inputValue  " ";
                        rml:parameter   grel:param_find
                      ];
        rml:input     [ a                  rml:Input;
                        rml:inputValueMap  [ rml:reference  "Name" ];
                        rml:parameter      grel:valueParam
                      ] .

<http://example.com/base/#NameMapping-RMLFNMLTC0051-CSV>
