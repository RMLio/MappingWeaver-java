        rml:predicateObjectMap  [ rml:objectMap  [ rml:languageMap  [ rml:functionExecution  <http://example.com/base/#Execution-RMLFNMLTC0081-CSV>;
                                                                      rml:return             grel:stringOut
                                                                    ];
                                                   rml:reference    "Name"
                                                 ];
