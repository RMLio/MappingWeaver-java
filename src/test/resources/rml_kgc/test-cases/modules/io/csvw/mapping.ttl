<http://example.com/ns#ProjectMapping-RMLIOREGTC0012h>
        a                       rml:TriplesMap;
        rml:logicalSource       <http://example.com/ns#LogicalSourceGrant-RMLIOREGTC0012h>;
        rml:predicateObjectMap  [ rml:objectMap  [ rml:reference  "Abstract" ];
                                  rml:predicate  schema:description
                                ];
        rml:subjectMap          [ rml:class     schema:ResearchProject;
                                  rml:template  "http://snf.ch/project/{GrantNumber}"
                                ] .

<http://example.com/ns#CSVW_sourceGrant-RMLIOREGTC0012h>
        a             csvw:Table;
        csvw:dialect  [ a               csvw:Dialect;
                        csvw:delimiter  ";"
                      ];
        csvw:url      "RMLIOREGTC0012h/data.csv" .

<http://example.com/ns#LogicalSourceGrant-RMLIOREGTC0012h>
        a                         rml:BaseSource;
        rml:referenceFormulation  rml:CSV;
        rml:source                <http://example.com/ns#CSVW_sourceGrant-RMLIOREGTC0012h> .
