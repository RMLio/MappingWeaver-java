PREFIX carml:     <http://carml.taxonic.com/carml/>
PREFIX csvw:      <http://www.w3.org/ns/csvw#>
PREFIX ex:        <http://example.com/>
PREFIX fnml:      <http://semweb.mmlab.be/ns/fnml#>
PREFIX fno:       <https://w3id.org/function/ontology#>
PREFIX foaf:      <http://xmlns.com/foaf/0.1/>
PREFIX gn:        <http://www.geonames.org/ontology#>
PREFIX grel:      <http://users.ugent.be/~bjdmeest/function/grel.ttl#>
PREFIX rml:       <http://w3id.org/rml/>
PREFIX schema:    <http://schema.org/>
PREFIX wgs84_pos: <http://www.w3.org/2003/01/geo/wgs84_pos#lat>
PREFIX xsd:       <http://www.w3.org/2001/XMLSchema#>

<http://example.com/base/TriplesMap1-RMLIOREGTC0012b>
        a                       rml:TriplesMap;
        rml:logicalSource       [ rml:referenceFormulation  rml:CSV;
                                  rml:source                <http://example.com/base/#CSVW_source-RMLIOREGTC0012b>
                                ];
        rml:predicateObjectMap  [ rml:objectMap  [ rml:reference  "Name" ];
                                  rml:predicate  foaf:name
                                ];
        rml:predicateObjectMap  [ rml:objectMap  [ rml:reference  "ID" ];
                                  rml:predicate  ex:id
                                ];
        rml:subjectMap          [ rml:class     foaf:Person;
                                  rml:template  "http://example.com/{ID}/{Name}"
                                ] .

<http://example.com/base/#CSVW_source-RMLIOREGTC0012b>
        a             csvw:Table;
        csvw:dialect  [ a               csvw:Dialect;
                        csvw:delimiter  ";"
                      ];
        csvw:null     "NULL";
        csvw:url      "RMLIOREGTC0012b/student.csv" .

<http://example.com/base/TriplesMap1-RMLIOREGTC0012c>
        a                       rml:TriplesMap;
        rml:logicalSource       [ rml:referenceFormulation  rml:CSV;
                                  rml:source                <http://example.com/base/#CSVW_source-RMLIOREGTC0012c>
                                ];
